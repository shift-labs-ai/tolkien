{
  "name": "@shiftlabs/tolkien",
  "version": "0.1.2",
  "description": "A fast lexer for natural text: one pass turns text into typed tokens such as words, numbers, dates, emails and URLs. Matchers of your own are described as data and run in Rust.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/main.js"
  },
  "bin": {
    "tolkien": "./dist/main.js"
  },
  "files": [
    "dist",
    "native.cjs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "npm run build && napi prepublish -t npm --skip-gh-release",
    "test": "bun test",
    "format": "bunx biome format --write src/ test/",
    "check": "bunx biome check src/ test/",
    "build:native": "napi build --release --strip --platform --features napi --cargo-flags=--no-default-features --cargo-cwd rust",
    "build:wasm": "cd rust && cargo build --lib --release --target wasm32-unknown-unknown --no-default-features --features wasm && wasm-bindgen --target web --out-dir ../npm/wasm --out-name engine target/wasm32-unknown-unknown/release/tolkien.wasm && cd .. && tsc -p tsconfig.wasm.json",
    "artifacts": "napi artifacts",
    "verify": "tools/verify.sh",
    "dev": "bun run src/main.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shift-labs-ai/tolkien.git"
  },
  "homepage": "https://github.com/shift-labs-ai/tolkien#readme",
  "bugs": {
    "url": "https://github.com/shift-labs-ai/tolkien/issues"
  },
  "keywords": [
    "lexer",
    "tokenizer",
    "text",
    "nlp",
    "pii",
    "rust"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@napi-rs/cli": "2.18.4",
    "@types/bun": "^1.3.0",
    "@types/node": "^25.5.0",
    "typescript": "^5.8.0"
  },
  "napi": {
    "name": "tolkien",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "optionalDependencies": {
    "@shiftlabs/tolkien-darwin-arm64": "0.1.2",
    "@shiftlabs/tolkien-darwin-x64": "0.1.2",
    "@shiftlabs/tolkien-linux-x64-gnu": "0.1.2",
    "@shiftlabs/tolkien-linux-arm64-gnu": "0.1.2",
    "@shiftlabs/tolkien-linux-x64-musl": "0.1.2",
    "@shiftlabs/tolkien-linux-arm64-musl": "0.1.2",
    "@shiftlabs/tolkien-win32-x64-msvc": "0.1.2"
  }
}
